# Copie ce fichier en `.env` puis adapte les valeurs si nécessaire.
# Le fichier `.env` ne doit JAMAIS être versionné.

# --- LLM et embeddings locaux (Ollama) ---------------------------------------
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
# Laisser false avec qwen3.5 : sinon la réflexion épuise les tokens
# et la réponse finale est vide.
OLLAMA_REASONING=false
EMBEDDING_MODEL=embeddinggemma-2:latest
EMBEDDING_BATCH_SIZE=32

# --- Découpage des documents -------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Recherche vectorielle ---------------------------------------------------
TOP_K=4
SCORE_MIN=0.70

# --- Source de données (OpenAgenda) ------------------------------------------
MAX_EVENEMENTS=500
DATE_MIN=2026-01-01T00:00:00

# --- Ingestion API -----------------------------------------------------------
MAX_UPLOAD_BYTES=20971520

# --- Journalisation ----------------------------------------------------------
LOG_LEVEL=INFO
