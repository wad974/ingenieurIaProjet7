# Contexte de build minimal : le code de l'API, pas les données ni les secrets
env/
venv/
.venv/

# Secrets
.env

# Git et IDE
.git/
.gitignore
.vscode/

# Python généré
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Données générées, montées en volumes au runtime
bdd/
documents/
logs/

# Scripts et dossier docker (l'entrypoint est copié explicitement par le
# Dockerfile) ; image de prod minimale
test/
scripts/
README.md

# Fichiers Docker eux-mêmes (inutiles dans l'image)
Dockerfile
docker-compose.yml
.dockerignore
